<UserControl
    x:Class="AltraVeraHostInstaller.Views.CustomMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AltraVeraHostInstaller.Views"
    Background="{x:Null}"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Border
        Background="WhiteSmoke"
        BorderThickness="1"
        BorderBrush="#0474A6"
        CornerRadius="10">
        <StackPanel
            Width="Auto"
            Height="Auto"
            Background="Transparent"
            Orientation="Vertical">
            <Border Background="#0474A6" Padding="10"
                    CornerRadius="7,7,0,0">
                <TextBlock
                    Name="txt_Title"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    FontFamily="{StaticResource Helvetica_Bold}"
                    FontWeight="Bold"
                    Foreground="WhiteSmoke"
                    Text="Confirmation" />
            </Border>

            <TextBlock
                Name="txt_Message"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20"
                FontFamily="{StaticResource Helvetica_Bold}"
                Foreground="Black"
                Text="Are you sure want to close application ?"
                TextWrapping="Wrap" />
            <StackPanel
                Name="dpTitleBar"
                Margin="20,0,20,10"
                HorizontalAlignment="Right"
                Background="Transparent"
                Orientation="Horizontal">
                <Button
                    Name="btnYes"
                    Width="75"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="clk_Yes"
                    Content="Yes"
                    Cursor="Hand"
                    FontFamily="{StaticResource Helvetica}"
                    Foreground="WhiteSmoke">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#0474A6" />
                            <Setter Property="Opacity" Value="0.9" />
                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border
                                            Padding="25,2,25,2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#ffffff"
                                            BorderThickness="0.1"
                                            CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Offset="1.2" Color="#0474A6" />
                                                <GradientStop Offset="0" Color="#69be9b" />
                                                <LinearGradientBrush.RelativeTransform>
                                                    <RotateTransform Angle="85" />
                                                </LinearGradientBrush.RelativeTransform>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    Name="btnNo"
                    Width="75"
                    Height="24"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="clk_No"
                    Content="No"
                    Cursor="Hand"
                    FontFamily="{StaticResource helvetica_light}"
                    Foreground="WhiteSmoke">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Black" />
                            <Setter Property="Opacity" Value="0.9" />
                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border
                                            Padding="25,2,25,2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#ffffff"
                                            BorderThickness="0.1"
                                            CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Offset="1.2" Color="#0474A6" />
                                                <GradientStop Offset="0" Color="#69be9b" />
                                                <LinearGradientBrush.RelativeTransform>
                                                    <RotateTransform Angle="85" />
                                                </LinearGradientBrush.RelativeTransform>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    Name="btnOk"
                    Width="75"
                    Height="24"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="clk_No"
                    Content="Ok"
                    FontFamily="{StaticResource helvetica_light}"
                    Foreground="WhiteSmoke"
                    Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#6E8ABE " />
                            <Setter Property="Opacity" Value="0.9" />
                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border
                                            Padding="25,2,25,2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#ffffff"
                                            BorderThickness="0.1"
                                            CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Offset="0.1" Color="#a6c94a" />
                                                <GradientStop Offset="1" Color="#69be9b" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
