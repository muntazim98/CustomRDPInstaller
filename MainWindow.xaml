                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource Helvetica}"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Text="License Agreement" />
                                <TextBlock
                                    Margin="0,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource Helvetica}"
                                    FontSize="13"
                                    Text="Please review Licence Agreement of AltraVera before installation" />
