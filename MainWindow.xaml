                                    </ScrollViewer>
                                </Border>
                                <CheckBox
                                    Margin="0,10"
                                    Checked="OnChecked"
                                    Cursor="Hand"
                                    FontSize="13"
                                    Unchecked="OnUnchecked">
                                    <CheckBox.Content>
                                        <TextBlock>
                                            <Run Text="I Accept and agree with all the" />
                                            <Run Foreground="#0474A6" Text="Terms &#38; Conditions" />
                                        </TextBlock>
                                    </CheckBox.Content>
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <StackPanel
                        x:Name="ButtonControl"
                        Grid.Row="1"
                        Margin="10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="NegativeButton"
                            MinWidth="170"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Stretch"
                            Background="#0997D7"
                            BorderThickness="0"
                            Click="MovePrevious"
                            Content="Done"
                            FontFamily="{DynamicResource GilroyMedium}"
                            FontSize="16"
                            Foreground="White"
                            Style="{DynamicResource ButtonStyle}" />
                        <Button
                            x:Name="PositiveButton"
                            Grid.Column="1"
                            MinWidth="170"
                            Margin="15,0,10,0"
                            HorizontalAlignment="Stretch"
                            Background="#0474A6"
                            BorderThickness="0"
                            Click="MoveNext"
                            Content="Launch"
                            FontFamily="{DynamicResource GilroyMedium}"
                            FontSize="16"
                            Foreground="White"
                            Style="{DynamicResource ButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
