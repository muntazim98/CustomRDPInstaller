                                    Margin="0"
                                    BorderBrush="Gray"
                                    BorderThickness="0.8"
                                    CornerRadius="5">
                                    <ScrollViewer
                                        Height="230"
                                        Margin="2"
                                        Padding="15"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
