<Window
    x:Class="CustomRDPInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CustomRDPInstaller"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1100"
    Height="700"
    AllowsTransparency="True"
    MouseDown="DragThisWindow"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="ButtonStyle1"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="55" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#07486A" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Helvetica}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="1" Color="#07486A" />
                                <GradientStop Offset="0" Color="#69be9b" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextBoxWithCornerRadiusStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3,0,0,3">
                            <!--  Adjust corner radius here  -->
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Images/background.png" />
    </Window.Background>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
            x:Name="CloseButton"
            Grid.Column="1"
            Width="30"
            Height="Auto"
            Margin="0,15,15,0"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="CloseButtonClick"
            Cursor="Hand"
            Style="{DynamicResource ButtonStyle1}"
            ToolTip="Close"
            Visibility="Visible">
            <Button.Content>
                <Path
                    Data="M16.3333 16.3333L1.66666 1.66663M16.3333 1.66663L1.66666 16.3333"
                    Stroke="White"
                    StrokeThickness="2" />
            </Button.Content>
        </Button>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="StartingGrid"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Visible">
                <StackPanel
                    Margin="0,10,0,50"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="250"
                        Height="250"
                        Source="/Resources/Images/UIIcon1.png"
                        Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock
                            x:Name="tAG"
                            Margin="5,5,10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{DynamicResource YaroOpBold}"
                            FontSize="100"
                            Foreground="White"
                            Text="AItraVera" />
                        <Border
                            Width="{Binding ElementName=tAG, Path=ActualWidth}"
                            Height="5"
                            Margin="0,-8,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="White" />
                        <TextBlock
                            Margin="10,0,0,5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Furore}"
                            FontSize="30"
                            FontWeight="DemiBold"
                            Foreground="#21a1db"
                            Text="SECURE RDP/UNC CONTROLLER" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid
                x:Name="LogoGrid"
                Grid.Row="0"
                Visibility="Collapsed">
                <StackPanel
                    Margin="0,50,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Height="80"
                        Source="/Resources/Images/UIIconSmall.png"
                        Stretch="Uniform" />
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            x:Name="tAG1"
                            Margin="0,5,10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{DynamicResource YaroOpBold}"
                            FontSize="42"
                            Foreground="White"
                            Text="AItraVera" />
                        <Border
                            Width="{Binding ElementName=tAG1, Path=ActualWidth}"
                            Height="2"
                            Margin="-8,-8,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="White" />
                        <TextBlock
                            Margin="0,0,0,5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Furore}"
                            FontSize="13"
                            Foreground="#21a1db"
                            Text="SECURE RDP/UNC CONTROLLER" />
                    </StackPanel>
                </StackPanel>

            </Grid>
            <Border
                x:Name="ContentBorder"
                Grid.Row="1"
                Width="500"
                MinHeight="300"
                Margin="0,30,0,0"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FFFFFF"
                CornerRadius="5"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid x:Name="UninstallationGrid" Visibility="Collapsed">
                            <StackPanel
                                Margin="40,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextBlock.TextAlignment="Left">
                                <Image
                                    x:Name="CompletedImage"
                                    Width="100"
                                    Height="110"
                                    Margin="0,30,0,10"
                                    Source="pack://application:,,,/Resources/Images/successicon.png"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="UninstallingTextBlock"
                                    Margin="0,30,0,10"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap">
                                    Software is already installed
                                </TextBlock>
                                <Label
                                    x:Name="RemoveAltraveraTextBlock1"
                                    Margin="0,10"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="Remove AltraVera from your computer."
                                    FontSize="13"
                                    Visibility="Collapsed" />
                                <Separator
                                    Height="2"
                                    x:Name="UninstallSeparator"
                                    Margin="0,0,0,20"
                                    Background="Black" />
                                <Label
                                    x:Name="RemoveAltraveraTextBlock2"
                                    Margin="0,20,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="AltraVera will be uninstalled from the following folder."
                                    FontSize="15"
                                    Visibility="Collapsed" />
                                <Label
                                    x:Name="RemoveAltraveraTextBlock3"
                                    Margin="0,5,0,20"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="Click Next to continue."
                                    FontSize="15"
                                    Visibility="Collapsed" />
                                <Label
                                    x:Name="RemoveAltraveraTextBlock4"
                                    Margin="0,10"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="Uninstalling AltraVera from:"
                                    FontSize="15"
                                    Visibility="Collapsed" />
                                <TextBox
                                    x:Name="pathTextbox"
                                    Grid.Column="0"
                                    Height="30"
                                    Margin="0,10"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="#BCBEC0"
                                    FontSize="13"
                                    Foreground="#BCBEC0"
                                    IsReadOnly="True"
                                    Style="{StaticResource TextBoxWithCornerRadiusStyle}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="UninstallingProgressText"
                                    Margin="0,0,0,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed">
                                    Process...
                                </TextBlock>
                                <Border
                                    x:Name="UnInstallingProgressBar"
                                    Height="20"
                                    Visibility="Collapsed">
                                    <ProgressBar
                                        Background="LightGray"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        IsIndeterminate="True">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.0" Color="#20A1DB" />
                                                <GradientStop Offset="1.0" Color="#0D88CC" />
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="FolderSelectionGrid"
                            Margin="20"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Helvetica_Bold}"
                                FontSize="32"
                                FontWeight="Bold"
                                Text="Destination Folder" />
                            <Rectangle
                                Grid.Row="1"
                                Height="1"
                                Margin="0,25"
                                Fill="#000000" />
                            <StackPanel Grid.Row="2">
                                <Label
                                    Padding="0"
                                    Content="Click next to install to the default folder or click Change"
                                    FontFamily="{DynamicResource Helvetica}"
                                    FontSize="16"
                                    FontWeight="Regular" />
                                <Label
                                    Padding="0"
                                    Content="to choose another folder."
                                    FontFamily="{DynamicResource Helvetica}"
                                    FontSize="16"
                                    FontWeight="Regular" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                                <Label
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Content="Install AltraVera to:"
                                    FontSize="16" />
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="pathInstalledTextbox"
                                        Grid.Column="0"
                                        Height="30"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="#BCBEC0"
                                        Foreground="#BCBEC0"
                                        Style="{StaticResource TextBoxWithCornerRadiusStyle}"
                                        Text="{Binding DefaultPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Name="Browsebtn"
                                        Grid.Column="1"
                                        Height="32"
                                        Margin="-5,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderThickness="0"
                                        Click="Browsebtn_Click"
                                        Content="Change"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="#282828">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border
                                                                Padding="20,5"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="#EBEBEB"
                                                                BorderThickness="2"
                                                                CornerRadius="0,3,3,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                    <GradientStop Offset="1.2" Color="#a6c94a" />
                                                                    <GradientStop Offset="0" Color="#69be9b" />
                                                                    <LinearGradientBrush.RelativeTransform>
                                                                        <RotateTransform Angle="85" />
                                                                    </LinearGradientBrush.RelativeTransform>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="White" />

                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="WelcomeGrid" Visibility="Collapsed">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.TextAlignment="Left">
                                <TextBlock
                                    Margin="0,30,0,10"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap">
                                    Welcome to the AltraVera Setup Wizard
                                </TextBlock>
                                <Separator
                                    Height="2"
                                    Margin="0,0,0,20"
                                    Background="Black" />
                                <TextBlock
                                    x:Name="Heading1"
                                    Margin="0,0,0,20"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    TextWrapping="Wrap">
                                    This wizard will guide you through the installation of AltraVera.
                                </TextBlock>
                                <TextBlock
                                    x:Name="Heading2"
                                    Margin="0,0,0,20"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    TextWrapping="Wrap">
                                    It is recommended that you close all other applications before starting Setup. This will make it possible to update relevant system files without having to reboot your computer.
                                </TextBlock>
                                <TextBlock
                                    x:Name="Heading3"
                                    Margin="0,0,0,40"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    TextWrapping="Wrap">
                                    Click Install Now to continue.
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="InstallingGrid"
                            Margin="30,0,30,0"
                            Visibility="Collapsed">
                            <StackPanel
                                MaxWidth="400"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.TextAlignment="Left">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap">
                                    Installing
                                </TextBlock>
                                <TextBlock
                                    Margin="0,0,0,20"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    TextWrapping="Wrap">
                                    Please wait while we are installing AltraVera on your Computer.
                                </TextBlock>
                                <Separator
                                    Height="2"
                                    Margin="0,0,0,10"
                                    Background="Black" />
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap">
                                    Process...
                                </TextBlock>
                                <Border Height="20">
                                    <ProgressBar
                                        x:Name="ProgressBar"
                                        Background="LightGray"
                                        BorderBrush="LightGray"
                                        BorderThickness="1">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.0" Color="#20A1DB" />
                                                <GradientStop Offset="1.0" Color="#0D88CC" />
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="SuccessCompletion"
                            Margin="0,0,0,35"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Vertical">
                                <Image
                                    Width="100"
                                    Height="110"
                                    Margin="0,30,0,10"
                                    Source="pack://application:,,,/Resources/Images/successicon.png" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource Helvetica}"
                                    FontSize="31"
                                    FontWeight="Bold"
                                    Foreground="#000000"
                                    Text="Installation Successful" />
                            </StackPanel>
                        </Grid>

