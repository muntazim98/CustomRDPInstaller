                                </ScrollViewer>
                            </Border>
                            <CheckBox Margin="0,10" FontSize="13">
                                <CheckBox.Content>
                                    <TextBlock>
                                        <Run Text="I Accept and agree with all the" />
                                        <Run Foreground="#0474A6" Text="Terms &#38; Conditions" />
                                    </TextBlock>
                                </CheckBox.Content>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid
                    x:Name="ButtonControl"
                    Grid.Row="1"
                    Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Margin="10,0,0,0"
                        Background="#0997D7"
                        BorderThickness="0"
                        Content="Done"
                        FontFamily="{DynamicResource Helvetica_Bold}"
                        FontSize="16"
                        Foreground="White"
                        Style="{DynamicResource ButtonStyle}" />
                    <Button
                        Grid.Column="1"
                        Margin="15,0,10,0"
                        Background="#0474A6"
                        BorderThickness="0"
                        Content="Launch"
                        FontFamily="{DynamicResource Helvetica_Bold}"
                        FontSize="16"
                        Foreground="White"
                        Style="{DynamicResource ButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
