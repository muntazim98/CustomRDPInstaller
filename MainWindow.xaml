<Window
    x:Class="CustomRDPInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CustomRDPInstaller"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowsTransparency="True"
    MouseDown="DragThisWindow"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            SnapsToDevicePixels="true" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBoxWithCornerRadiusStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <!--  Adjust corner radius here  -->
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/background.png" />
    </Window.Background>
    <Grid x:Name="MainGrid" Margin="280,80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="LogoGrid" Grid.Row="0">
            <StackPanel
                Margin="0,10,0,50"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Height="80"
                    Source="/Resources/Images/successicon.png"
                    Stretch="UniformToFill" />
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        x:Name="tAG"
                        Margin="10,5,10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontFamily="{DynamicResource Helvetica}"
                        FontSize="42"
                        Foreground="White"
                        Text="AltraVera" />
                    <Border
                        Width="{Binding ElementName=tAG, Path=ActualWidth}"
                        Height="2"
                        Margin="0,-8,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="White" />
                    <TextBlock
                        Margin="10,0,0,5"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Helvetica}"
                        FontSize="12"
                        Foreground="#21a1db"
                        Text="SECURE RDP/UNC CONTROLLER" />
                </StackPanel>
            </StackPanel>

        </Grid>
        <Border
            x:Name="ContentBorder"
            Grid.Row="1"
            MinWidth="400"
            MinHeight="300"
            Margin="0,0,0,90"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid
                        x:Name="FolderSelectionGrid"
                        Margin="20"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            FontSize="32"
                            FontWeight="Bold"
                            Text="Destination Folder" />
                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="#000000" />
                        <StackPanel Grid.Row="2">
                            <Label
                                Padding="0"
                                Content="Click next to install to the default folder or click Change"
                                FontSize="16" />
                            <Label
                                Padding="0"
                                Content="to choose another folder."
                                FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,20,0,0">
                            <Label
                                Padding="0"
                                Content="Install Virto Sign to:"
                                FontSize="16" />
                            <StackPanel Margin="0,5" Orientation="Horizontal">
                                <TextBox
                                    x:Name="pathTextbox"
                                    Width="225"
                                    Height="30"
                                    VerticalContentAlignment="Center"
                                    Style="{StaticResource TextBoxWithCornerRadiusStyle}"
                                    Text="{Binding DefaultPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Border
                                    Height="32"
                                    Margin="-40,0,0,0"
                                    BorderBrush="White"
                                    BorderThickness="0.8"
                                    CornerRadius="4">
                                    <Button
                                        Name="Browsebtn"
                                        Height="32"
                                        Padding="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Click="Browsebtn_Click"
                                        Content="Browse..."
                                        Cursor="Hand"
                                        FontSize="10"
                                        Foreground="#FFFFFF">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Background" Value="#092E5A" />
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="BorderBrush" Value="#092E5A" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border
                                                                Padding="8"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="#ffffff"
                                                                BorderThickness="0.1"
                                                                CornerRadius="5">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Border>
                                <Border
                                    Height="30"
                                    Margin="5"
                                    BorderBrush="#092E5A"
                                    BorderThickness="0.8"
                                    CornerRadius="4">
                                    <Button
                                        Name="DiskCostBtn"
                                        Height="30"
                                        Padding="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Click="DiskCostBtn_Click"
                                        Content="Disk Info"
                                        Cursor="Hand"
                                        FontSize="10"
                                        Foreground="#092E5A">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Opacity" Value="0.9" />
                                                <Setter Property="BorderBrush" Value="#092E5A" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border
                                                                Padding="8"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="#ffffff"
                                                                BorderThickness="0.1"
                                                                CornerRadius="5">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="WelcomeGrid" Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.TextAlignment="Left">
                            <TextBlock
                                Margin="0,30,0,10"
                                FontSize="28"
                                FontWeight="Bold"
                                TextWrapping="Wrap">
                                Welcome to the Virto Sign Setup Wizard
                            </TextBlock>
                            <Separator
                                Height="2"
                                Margin="0,0,0,20"
                                Background="Black" />
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="14"
                                FontWeight="Normal"
                                TextWrapping="Wrap">
                                This wizard will guide you through the installation of Virto Sign.
                            </TextBlock>
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="14"
                                FontWeight="Normal"
                                TextWrapping="Wrap">
                                It is recommended that you close all other applications before starting Setup. This will make it possible to update relevant system files without having to reboot your computer.
                            </TextBlock>
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="14"
                                FontWeight="Normal"
                                TextWrapping="Wrap">
                                Click Install Now to continue.
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Grid
                        x:Name="Installing"
                        Margin="30,0,30,0"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.TextAlignment="Left">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="28"
                                FontWeight="Bold"
                                TextWrapping="Wrap">
                                Installing
                            </TextBlock>
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="14"
                                FontWeight="Normal"
                                TextWrapping="Wrap">
                                Please wait while we are installing Virto Sign on your Computer.
                            </TextBlock>
                            <Separator
                                Height="2"
                                Margin="0,0,0,10"
                                Background="Black" />
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap">
                                Process...
                            </TextBlock>
                            <ProgressBar
                                Height="20"
                                Background="Transparent"
                                BorderBrush="LightGray"
                                BorderThickness="1" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="InstallingGrid">
                        <StackPanel />
                    </Grid>
                    <Grid x:Name="ClosingGrid">
                        <StackPanel />
                    </Grid>
                    <Grid x:Name="SuccessCompletion" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <Image
                                Width="100"
                                Height="110"
                                Margin="0,30,0,10"
                                Source="pack://application:,,,/Resources/Images/successicon.png" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource Helvetica}"
                                FontSize="31"
                                FontWeight="Bold"
                                Foreground="#000000"
                                Text="Installation Successful" />
                        </StackPanel>
                    </Grid>

