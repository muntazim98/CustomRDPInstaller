                                <TextBlock
                                    Margin="0,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource Helvetica}"
                                    FontSize="16"
                                    Text="Please scroll down to see rest of the agreement." />
